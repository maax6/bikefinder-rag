# PostgreSQL (docker-compose defaults, override if needed)
POSTGRES_USER=bikefinder
POSTGRES_PASSWORD=bikefinder
POSTGRES_DB=bikefinder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Anthropic API key, only for the remote anthropic backend.
# The legacy local Ollama path needs no API key; the optional Jev router does.
ANTHROPIC_API_KEY=

# Agent backend: "ollama" (default) for local dev/testing,
# or explicitly "anthropic" / "openrouter" for remote inference.
# (e.g. Mistral Small 3.2 via `ollama pull mistral-small3.2`, no API key needed).
AGENT_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral-small3.2
# Per-request read timeout: model loading/generation may be slow locally.
OLLAMA_TIMEOUT_SECONDS=300
# Cooperative total budget for one user turn (requests + tools).
# Checked between operations; an in-progress DB/CPU tool is not interrupted.
OLLAMA_TURN_TIMEOUT_SECONDS=180

# Once BGE-M3 and the enabled reranker are downloaded, skip the Hub metadata
# ping at every model load — silences the "unauthenticated requests" warning
# and starts faster. Leave commented for the very first run (it downloads).
# HF_HUB_OFFLINE=1

# Scraper politeness
SCRAPER_DELAY_SECONDS=1.5

# Optional fast router; enable after importing an enriched catalog.
# Questions and selected synthesis evidence are sent to Jev via OpenRouter.
BIKEFINDER_JEV_ROUTER=0
# Enable exact SQL identity -> local BGE -> source-only answers, including A2.
BIKEFINDER_JEV_RAG=0
BIKEFINDER_CATALOG_FAST_PATH=0
OPENROUTER_API_KEY=
JEV_ROUTER_TIMEOUT_SECONDS=5
CATALOG_SYNTHESIS_TIMEOUT_SECONDS=30
