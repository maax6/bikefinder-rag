# PostgreSQL (docker-compose defaults, override if needed)
POSTGRES_USER=bikefinder
POSTGRES_PASSWORD=bikefinder
POSTGRES_DB=bikefinder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Anthropic API key, only for the remote anthropic backend.
# The default local Ollama backend needs no API key.
ANTHROPIC_API_KEY=

# Agent backend: "ollama" (default) for local dev/testing,
# or explicitly "anthropic" / "openrouter" for remote inference.
# (e.g. Mistral Small 3.2 via `ollama pull mistral-small3.2`, no API key needed).
AGENT_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral-small3.2

# Once BGE-M3 and the enabled reranker are downloaded, skip the Hub metadata
# ping at every model load — silences the "unauthenticated requests" warning
# and starts faster. Leave commented for the very first run (it downloads).
# HF_HUB_OFFLINE=1

# Scraper politeness
SCRAPER_DELAY_SECONDS=1.5
